# Copia este archivo como .env y ajusta las URL al servidor donde corre la rama back.
# Base de cada microservicio (sin la barra final). Los endpoints se agregan como /view/...
EXPO_PUBLIC_MS_DISPONIBILIDAD_URL=http://localhost/CampoDeportivoRosas/back/ms-disponibilidad/public/index.php
EXPO_PUBLIC_MS_RESERVAS_URL=http://localhost/CampoDeportivoRosas/back/ms-reservas/public/index.php

# true  = usa datos de prueba locales (el back no necesita estar corriendo)
# false = llama a los microservicios reales
EXPO_PUBLIC_USE_MOCKS=true
